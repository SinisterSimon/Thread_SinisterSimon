# Local Postgres from docker-compose.yml. Leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg://thread:thread@localhost:5432/thread

# "offline" = scripted replies, free. "anthropic" = real Claude models.
LLM_MODE=offline
# Shadow drafts on the Live store only. Defaults to LLM_MODE. Lets drafts use
# real Claude while the simulated lab (thousands of calls) stays offline.
DRAFT_LLM_MODE=offline
# Only needed when LLM_MODE or DRAFT_LLM_MODE is anthropic. Never commit a real key.
ANTHROPIC_API_KEY=

# 1 = a separate worker process runs experiments (python -m worker.run).
# 0 = the web app runs them itself.
WORKER_ENABLED=0

# Model for the AI judge that scores conversations (Phase 3).
JUDGE_MODEL=claude-sonnet-5-5

# Optional: Langfuse tracing. Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# v2: a Shopify development store (Dev Dashboard app, read-only scopes:
# read_products,read_customers,read_orders). Never commit the secret.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
