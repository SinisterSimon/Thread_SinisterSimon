# Local Postgres from docker-compose.yml. Leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg://thread:thread@localhost:5432/thread

# "offline" = scripted replies, free. "live" = real models (claude-* via Anthropic,
# gemini-* via Google). "anthropic" is the older name for "live" and still works.
LLM_MODE=offline
# Shadow drafts on the Live store only. Defaults to LLM_MODE. Lets drafts use
# real models while the simulated lab (thousands of calls) stays offline.
DRAFT_LLM_MODE=offline
# Only needed in live mode, and only for the models you use. Never commit a real key.
ANTHROPIC_API_KEY=
# Gemini agents (Baseline · Gemini Flash / Argon). Key from aistudio.google.com.
GEMINI_API_KEY=
# GPT agents (Baseline · GPT Luna / Terra / Sol / Astra). Key from platform.openai.com;
# API credit is separate from a ChatGPT subscription.
OPENAI_API_KEY=

# 1 = a separate worker process runs experiments (python -m worker.run).
# 0 = the web app runs them itself.
WORKER_ENABLED=0

# Model for the AI judge that scores conversations (Phase 3).
JUDGE_MODEL=claude-sonnet-5-5

# Optional: Langfuse tracing. Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# v2: a Shopify development store (Dev Dashboard app, read-only scopes:
# read_products,read_customers,read_orders). Never commit the secret.
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Facts the agent may use for your Shopify store, separated by "|". Only true facts:
# the agent is told never to invent any. Unset = the lab's default facts.
SHOPIFY_STORE_FACTS=

# Bot-shopper loop (docs/bot-loop.md). Draft automatically when a webhook brings new
# checkouts, with this agent; empty = sync only. Guardrails on unless set to 0.
AUTO_DRAFT_AGENT=
AUTO_DRAFT_GUARDRAILS=1
# The dev store's storefront password, for the bots (python -m bots.abandon_cart).
SHOPIFY_STOREFRONT_PASSWORD=

# Safe sending (docs/sending.md). Console by default: nothing leaves Thread.
SEND_MODE=console
# Only these numbers can ever receive a text (your own phone), comma-separated, +country form.
SEND_ALLOWLIST=
# "Send to my phone" on the Live store sends drafts here (must be on the allowlist).
SEND_TEST_TO=
SEND_PER_DAY=10
# Only for SEND_MODE=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# The site's public address, so Twilio's signature can be checked behind Render's proxy.
PUBLIC_BASE_URL=
